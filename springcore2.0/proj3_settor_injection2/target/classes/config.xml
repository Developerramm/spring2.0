<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->

    <bean class="com.spring.beans.Student" id="student">
        <property name="name" value="Ram Kumar" />
        <property name="username" value="ram@123" />
        <property name="email" value="ram@gmail.com" />
        <property name="course" ref="course" />

    </bean>
    
    <bean class="com.spring.beans.Course" id="course">
    </bean>

    <bean class="java.util.Date" id="d1">
        <property name="year"  value="125" />
        <property name="month"  value="5" />
        <property name="date"  value="29" />
    </bean>

    <bean class="com.spring.beans.Employee" id="emp">
        <property name="empName" value="Rajesh" />
        <property name="dpt" value="IT" />
        <property name="empDob" ref="d1"  />
    </bean>

</beans>