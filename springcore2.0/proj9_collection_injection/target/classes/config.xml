<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <!-- bean definitions here -->
    <bean class="java.util.Date" id="d1">
        <property name="year" value="125"></property>
        <property name="month" value="6"></property>
        <property name="date" value="6"></property>
    </bean>
    <bean class="java.util.Date" id="d2">
        <property name="year" value="124"></property>
        <property name="month" value="3"></property>
        <property name="date" value="7"></property>
    </bean>
    <bean class="com.app.beans.Student" id="student">
        <property name="name" value="Ram"></property>
        <property name="marks">
            <array>
                <value>80</value>
                <value>90</value>
                <value>100</value>
                <value>83</value>
                <value>93</value>
            </array>
        </property>
    </bean>
    <bean class="com.app.beans.Faculty" id="faculty">
        <property name="name">
            <list>
                <value>ram kumar</value>
                <value>Mintu singh</value>
                <value>Mohan Lala chaturvedi</value>
                <value>Pooja Singh</value>
            </list>
        </property>
        <property name="joiningDate">
            <list>
                <ref bean="d1" />
                <ref bean="d2" />
            </list>
        </property>
    </bean>
    <bean class="com.app.beans.User" id="user">
        <property name="phoneNumber">
            <set value-type="java.lang.Long">
                <value>1425</value>
                <value>9543</value>
                <value>324</value>
                <value>0147</value>
            </set>
        </property>
        <property name="email">
            <set>
                <value>a@gmail.com</value>
                <value>b@gmail.com</value>
                <value>c@gmail.com</value>
            </set>
        </property>
    </bean>
    <bean class="com.app.beans.CollegeInfo" id="info">
        <property name="hod">
            <map>
                <entry key="Physics" value="Ram bana"></entry>
                <entry key="math" value=" Gaguu"></entry>
            </map>
        </property>
        <property name="holiday">
            <map>
                <entry key="firsthday" value-ref="d1"></entry>
                <entry key="secondday" value-ref="d2"></entry>
            </map>
        </property>
    </bean>
</beans>