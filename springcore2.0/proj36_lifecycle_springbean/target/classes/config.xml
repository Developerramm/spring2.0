<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:context="http://www.springframework.org/schema/context" 
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">
    <!-- bean definitions here -->
    <bean class="com.app.beans.User" id="user" init-method="initialize" destroy-method="destroy">
        <property name="name" value="Ram kumar" />
        <property name="date" ref="d1"/>
    </bean>
    <bean class="java.util.Date" id="d1">
        <property name="year" value="125"></property>
        <property name="month" value="7"></property>
        <property name="date" value="12"></property>
    </bean>
    <!-- <context:component-scan base-package="com.app" />
    <context:property-placeholder location="application.properties" /> -->
</beans>