<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <!-- bean definitions here -->
    <bean abstract="true" id="car" class="com.app.beans.Car">
        <property name="tyre" value="mrf" />
        <property name="enginePower" value="2400" />
        <property name="fuelType" value="Petrol" />
        <property name="company" value="Hundai" />
    </bean>
    <bean class="com.app.beans.Car" id="car1" parent="car">
        <property name="model" value="Creta 2025" />
        <property name="regNo" value="xh-45120" />
    </bean>
    <bean class="com.app.beans.Car" id="car2" parent="car">
        <property name="model" value="Creta 20266" />
        <property name="regNo" value="xh-5642113120" />
    </bean>
</beans>